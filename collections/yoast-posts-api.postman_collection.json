          "name": "List Posts With SEO Data",
          "request": {
            "name": "List Posts With SEO Data",
            "description": {
              "content": "Returns WordPress posts with Yoast SEO metadata appended. Each post in the response includes yoast_head (HTML meta tags and Schema.org output) and yoast_head_json (structured key/value SEO data).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wp",
                "v2",
                "posts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "slug",
                  "value": "<string>",
                  "description": "Filter by post slug"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "10",
                  "description": "Number of posts per page (max 100)"
                }
              ],
              "variable": [
                {
                  "description": "Your WordPress site domain",
                  "type": "any",
                  "value": "{{site}}",
                  "key": "site"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
