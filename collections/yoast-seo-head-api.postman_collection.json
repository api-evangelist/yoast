          "id": "e4f049ca-9a11-4eb4-ae66-5a86012ad786",
          "name": "Get SEO Head for URL",
          "request": {
            "name": "Get SEO Head for URL",
            "description": {
              "content": "Returns all SEO metadata for a given URL including meta tags, Schema.org JSON-LD structured data, canonical URL, robots directives, Open Graph tags, and Twitter Card data. This is the primary endpoint for headless WordPress implementations.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "yoast",
                "v1",
                "get_head"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "(Required) The full URL of the page to retrieve SEO metadata for"
                }
              ],
              "variable": [
                {
                  "description": "Your WordPress site domain",
                  "type": "any",
                  "value": "{{site}}",
                  "key": "site"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
