          "request": {
            "name": "List Pages With SEO Data",
            "description": {
              "content": "Returns WordPress pages with Yoast SEO metadata appended. Each page includes yoast_head and yoast_head_json fields.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wp",
                "v2",
                "pages"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "slug",
                  "value": "<string>",
                  "description": "Filter by page slug"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "10",
                  "description": "Number of pages per page (max 100)"
                }
              ],
              "variable": [
                {
                  "description": "Your WordPress site domain",
                  "type": "any",
                  "value": "{{site}}",
                  "key": "site"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
