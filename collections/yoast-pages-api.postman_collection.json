    "_postman_id": "336994b5-803d-4f86-94fb-d6a0932170d2",
    "name": "Yoast REST Pages API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Yoast REST API returns all SEO metadata (meta tags, Schema.org JSON-LD, canonical URLs, Open Graph, Twitter Card data, and robots directives) for any URL or post on a WordPress site. The API is read-only and designed for headless WordPress implementations. It extends the WordPress WP-JSON REST API and provides a dedicated SEO head endpoint.\n\nContact Support:\n Name: Yoast Developer Portal",
      "type": "text/plain"
    }
  }
